<Window x:Class="WindowCapture.WPF.OpenAppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WindowCapture.WPF"
        mc:Ignorable="d"
        Title="Select Running App"
        Height="350" Width="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button Content="OK"     Width="72" Margin="0,0,8,0" Click="Ok_Click"     IsDefault="True"/>
            <Button Content="Cancel" Width="72"                   Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>

        <ListBox x:Name="AppListBox"
                 DisplayMemberPath="Title"
                 MouseDoubleClick="AppListBox_DoubleClick"/>
    </DockPanel>
</Window>
